# Export these into the process; the service does not implicitly read .env files.
AI_SERVICE_TOKEN=
GITHUB_TOKEN=
GITHUB_PRIVATE_PROJECT_REPOS_JSON={}
REPOSITORY_RUNNER_URL=
REPOSITORY_RUNNER_TOKEN=
RUNNER_SECURITY_APPROVED=false
# Project -> agreed suite ID -> immutable operator-owned test-bundle digest.
RUNNER_TRUSTED_SUITES_JSON={}

# Optional existing Python requirements/RAG scripts (not needed for verification).
GOOGLE_API_KEY=
# Set GEMINI_MODEL to a model available to your account when using those scripts.
