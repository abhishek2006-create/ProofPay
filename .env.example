NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
AI_API_KEY=
# Selected Grok setup: AI_PRETRAINED_MODEL=grok-4.7,
# AI_BASE_URL=https://api.x.ai/v1. AI_API_KEY must be an xAI API key.
AI_MODEL=
AI_BASE_URL=
# AI_MODEL remains a backward-compatible alias for AI_PRETRAINED_MODEL.
AI_PRETRAINED_MODEL=
AI_RESPONSE_FORMAT=json_schema
ELASTIC_URL=
ELASTIC_API_KEY=
ZAPIER_WEBHOOK_URL=
ENABLE_DEMO=false

EMBEDDING_MODEL=
# Leave embeddings blank for explicit lexical retrieval with the Grok setup.
# For a separate embedding provider, configure its model, URL and its own key.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
GITHUB_TOKEN=
GITHUB_PRIVATE_PROJECT_REPOS_JSON={}
REPOSITORY_RUNNER_URL=
