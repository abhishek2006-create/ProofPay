DATABASE_URL=postgresql://proofpay:proofpay_local_only@localhost:5438/proofpay
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
AI_API_KEY=
# Selected Groq setup: AI_PRETRAINED_MODEL=openai/gpt-oss-20b,
# AI_BASE_URL=https://api.groq.com/openai/v1. AI_API_KEY must be a Groq API key.
AI_MODEL=
AI_BASE_URL=
# AI_MODEL remains a backward-compatible alias for AI_PRETRAINED_MODEL.
AI_PRETRAINED_MODEL=
AI_RESPONSE_FORMAT=json_schema
ELASTIC_URL=
ELASTIC_API_KEY=
ZAPIER_WEBHOOK_URL=
ENABLE_DEMO=false

EMBEDDING_MODEL=
# Leave embeddings blank for explicit lexical retrieval with the Groq setup.
# For a separate embedding provider, configure its model, URL and its own key.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Required verification backend (Python). No TypeScript fallback.
# npm run dev supplies a fresh URL/token automatically for local development.
# For separately managed services, use the same random token on both services.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
# GitHub and runner credentials belong in ai-service/.env, not this file.
# Existing AI_* and EMBEDDING_* settings above still power optional document
# suggestions, retrieval and advisory review in Next.js; they are not obsolete.
