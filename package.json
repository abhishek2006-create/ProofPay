{
  "name": "proofpay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api": "newman run docs/postman.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write src tests scripts prisma/seed.ts docs *.ts *.mjs *.json *.md *.yml",
    "evaluate": "tsx scripts/evaluate.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "rag:status": "tsx scripts/rag-status.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "jszip": "^3.10.2",
    "newman": "^6.2.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
